# ==============================================================================
# FreightPact Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env to source control!
# ==============================================================================

# Application environment: development | test | production
FREIGHTPACT_ENV=development

# ------------------------------------------------------------------------------
# Agent Seeds (Identity & Mailbox)
# Stable mnemonic seed phrases for deterministic agent addresses on Agentverse.
# Do NOT reuse public tutorial seeds in production.
# ------------------------------------------------------------------------------
COORDINATOR_SEED="freightpact_coordinator_recovery_agent_secure_seed_phrase_demo"
CARRIER_ALPHA_SEED="freightpact_carrier_alpha_safe_transport_secure_seed_demo"
CARRIER_BETA_SEED="freightpact_carrier_beta_budget_transport_secure_seed_demo"
CARRIER_GAMMA_SEED="freightpact_carrier_gamma_backup_transport_secure_seed_demo"
AUDITOR_SEED="freightpact_telemetry_auditor_verification_secure_seed_demo"

# ------------------------------------------------------------------------------
# Agentverse & ASI:One API Configuration
# Required for hosting agent mailboxes and conversational LLM intent extraction.
# ------------------------------------------------------------------------------
AGENTVERSE_API_KEY=""
ASI_API_KEY=""

# ------------------------------------------------------------------------------
# Cryptographic Fixture Secret
# Symmetric secret key used to compute and verify HMAC-SHA256 signatures
# on synthetic sensor telemetry payloads.
# ------------------------------------------------------------------------------
HMAC_FIXTURE_SECRET="freightpact-synthetic-telemetry-fixture-hmac-secret-dev-key"

# ------------------------------------------------------------------------------
# Orchestration & Operational Policy Parameters
# ------------------------------------------------------------------------------
DATABASE_PATH="freightpact.db"
MAX_AUDIT_ATTEMPTS=3
AGENT_PORT_START=8000
